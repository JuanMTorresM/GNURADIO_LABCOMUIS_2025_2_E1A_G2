- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Bloque 1: Estimador de Potencia\"\"\"\n\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Power_Estimator',\
      \         # Nombre del bloque\n            in_sig=[(np.complex64, 1024)],  #\
      \ Entrada: vector complejo de 1024 muestras\n            out_sig=[np.float32]\
      \            # Salida: un valor float (potencia promedio)\n        )\n\n   \
      \ def work(self, input_items, output_items):\n        # input_items[0] es una\
      \ lista de vectores complejos\n        for i, ventana in enumerate(input_items[0]):\n\
      \            potencia = np.mean(np.abs(ventana)**2)\n            output_items[0][i]\
      \ = potencia\n\n        return len(output_items[0])\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Power_Estimator'', ''blk'', [], [(''0'', ''complex'', 1024)], [(''0'',
      ''float'', 1)], ''Bloque 1: Estimador de Potencia'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 104.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='Amplitude Statistics',  # Nombre del bloque\n           \
      \ in_sig=[(np.complex64, 1024)],\n            out_sig=[np.float32, np.float32]\n\
      \        )\n\n    def work(self, input_items, output_items):\n        ventana\
      \ = input_items[0][0]  # vector complejo\n        magnitudes = np.abs(ventana)\n\
      \n        output_items[0][0] = np.mean(magnitudes)  # media de amplitudes\n\
      \        output_items[1][0] = np.std(magnitudes)   # desviaci\xF3n est\xE1ndar\
      \ de amplitudes\n        return 1\n\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Amplitude Statistics', 'blk', [], [('0', 'complex', 1024)], [('0',
      'float', 1), ('1', 'float', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 224.0]
    rotation: 0
    state: enabled
